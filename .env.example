# Docker Compose reads .env; Python CLI uses exported environment variables.
NEWS_RSS_URLS=https://www.mining.com/feed/
# Required only for live PDF extraction; use a provider supporting JSON chat responses.
EXTRACTOR_BASE_URL=https://api.openai.com/v1
EXTRACTOR_MODEL=gpt-4o
EXTRACTOR_API_KEY=
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_ATTEMPTS=3
# Operator-provided authorized LME data; one is sufficient.
LME_PRICE_CSV=
LME_PRICE_JSON_URL=
