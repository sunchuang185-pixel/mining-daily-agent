# Docker Compose 读取 .env；Python 命令行读取已导出的环境变量。
NEWS_RSS_URLS=https://www.mining.com/feed/
# 仅在 live 模式提取 PDF 时必需；使用支持 JSON 聊天响应的模型服务。
EXTRACTOR_BASE_URL=https://api.openai.com/v1
EXTRACTOR_MODEL=gpt-4o
EXTRACTOR_API_KEY=
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_ATTEMPTS=3
# 使用者提供已获授权的 LME 数据；以下两种来源配置其一即可。
LME_PRICE_CSV=
LME_PRICE_JSON_URL=
